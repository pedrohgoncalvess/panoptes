{
  "manifest_version": 3,
  "name": "Panoptes — Sessões",
  "version": "0.4.0",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "description": "Coleta páginas de Amazon, Mercado Livre, Pichau e Terabyte no navegador escolhido pelo usuário.",
  "minimum_chrome_version": "120",
  "permissions": [
    "cookies",
    "scripting",
    "activeTab",
    "storage",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "host_permissions": [
    "https://*.mercadolivre.com.br/*",
    "https://*.mercadolivre.com/*",
    "https://*.mercadolibre.com/*",
    "https://*.mercadopago.com.br/*",
    "https://*.amazon.com.br/*",
    "https://*.amazon.com/*",
    "https://*.pichau.com.br/*",
    "https://*.terabyteshop.com.br/*"
  ],
  "optional_host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://*/*"
  ],
  "action": {
    "default_title": "Conectar navegador ao Panoptes",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
