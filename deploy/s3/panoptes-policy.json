{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "FullAccessToPanoptesBucket",
      "Effect": "Allow",
      "Action": ["s3:*"],
      "Resource": ["arn:aws:s3:::panoptes", "arn:aws:s3:::panoptes/*"]
    },
    {
      "Sid": "DenyOtherBuckets",
      "Effect": "Deny",
      "Action": ["s3:*"],
      "NotResource": ["arn:aws:s3:::panoptes", "arn:aws:s3:::panoptes/*"]
    }
  ]
}
