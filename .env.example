# Local development defaults only.
POSTGRES_PORT=5432
BACKEND_PORT=8000
BACKEND_HOST=localhost
PANOPTES_API_URL=
FRONTEND_PORT=3000
FRONTEND_DEV_PORT=5173
S3_PORT=9000
MINIO_CONSOLE_PORT=9001
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/postgres
MIGRATIONS_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/postgres
DB_POOL_MIN=2
DB_POOL_MAX=10
JWT_SECRET=panoptes-local-development-jwt-secret-change-me
# Optional startup superuser. All three values must be set to create/update it.
SUPERUSER_NAME=admin
SUPERUSER_EMAIL=admin@panoptes.com
SUPERUSER_PASSWORD=admin
PANOPTES_EMAIL=admin@panoptes.com
PANOPTES_PASSWORD=admin
PANOPTES_API_URL=http://localhost:8000
# MCP credential issued by a logged-in user at /mcp-keys.
PANOPTES_MCP_KEY=
# Allow private/localhost webhook receivers only on trusted deployments.
WEBHOOK_ALLOW_PRIVATE_NETWORKS=false
OPENROUTER_API_KEY=
OPENROUTER_SYNC_INTERVAL_SECONDS=3600
COMMERCE_LLM_ENABLED=true
PRODUCT_CLASSIFIER_ENABLED=true
PRODUCT_NORMALIZER_ENABLED=true
TAXONOMY_NORMALIZER_ENABLED=true
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=panoptes
AMAZON_REQUEST_INTERVAL_SECONDS=1.5

# Optional authenticated browser service. Generate key/token (see docs/browser-connections.md).
BROWSER_SESSION_KEY=
BROWSER_SERVICE_TOKEN=
# Compose: http://backend:8000. Local workers: http://localhost:8000.
BROWSER_SERVICE_URL=
# Mercado Livre uses windowed Chromium (virtual display inside Docker).
BROWSER_MERCADO_LIVRE_HEADLESS=false
BROWSER_RETAIL_HEADLESS=false
